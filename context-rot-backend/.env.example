APP_NAME=Context Rot Detection API
DATABASE_URL=sqlite:///./context_rot.db
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_PROVIDER=offline
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
MODEL_TIMEOUT_SECONDS=45
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=0.25
JOB_LEASE_SECONDS=300
RECOVERY_THRESHOLD=65
ENABLE_DEMO_FAULTS=true
