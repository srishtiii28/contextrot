APP_NAME=Context Rot Detection API
DATABASE_URL=sqlite:///./context_rot.db
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_PROVIDER=offline
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
MODEL_TIMEOUT_SECONDS=45
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=0.25
JOB_LEASE_SECONDS=300
RECOVERY_THRESHOLD=65
# Reliability layer (docs/RELIABILITY.md): rules (offline demo) | judge (v1, LLM) | nli (v2, local; pip install -r requirements-nli.txt)
RELIABILITY_DETECTOR=rules
RELIABILITY_TIMEOUT_SECONDS=10
RELIABILITY_HISTORY_TURNS=6
SKIP_SOCIAL_TURNS=true
# Judge defaults to LLM_PROVIDER and that provider's model; use a different model to limit self-preference bias.
JUDGE_PROVIDER=
# Separate key for the judge (blank = use the provider key above)
JUDGE_API_KEY=
JUDGE_MODEL=
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# v2 compares only sentences at least this similar (MiniLM cosine); lower = more recall, more false alarms
NLI_PAIR_MIN_SIMILARITY=0.70
# Health score H = 100 - sum(weight * severity). Placeholders until fitted with scripts/eval_reliability.py.
W_CONTRADICTION=50
W_INSTRUCTION=45
W_COURSE_CONFLICT=45
W_DRIFT=45
ENABLE_DEMO_FAULTS=true
# Optional teammate endpoints. Leave blank for offline demo baselines.
RAG_SERVICE_URL=
ROT_SERVICE_URL=
INTEGRATION_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
CHROMA_DB_DIR=chroma_db
UPLOAD_DIR=uploads
