{
  "manifest_version": 3,
  "name": "Context Rot Detector",
  "version": "1.0.0",
  "description": "Simple frontend for testing the Context Rot backend.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}